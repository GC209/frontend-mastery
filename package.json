{
  "name": "frontend-mastery",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Frontend interview and AI-code-review prep: notes, solved problems with tests, and code reviews.",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
